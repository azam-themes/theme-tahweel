{# ============================================
   Newsletter Popup Component - ثيم تحويل
   نافذة الاشتراك بالنشرة البريدية مع كود خصم
   ============================================ #}

<div class="quick-view-overlay" id="newsletterPopup">
    <div class="quick-view" style="max-width: 500px; text-align: center;">
        <button onclick="document.getElementById('newsletterPopup').classList.remove('quick-view-overlay--active'); localStorage.setItem('newsletter_closed', 'true');" style="position: absolute; top: 16px; left: 16px; font-size: 20px; color: #9ca3af;">
            <i class="sicon-cancel"></i>
        </button>

        {% if component.bg_image %}
        <div style="margin: -24px -24px 24px; height: 200px; overflow: hidden; border-radius: var(--radius-lg) var(--radius-lg) 0 0;">
            <img src="{{ component.bg_image }}" alt="" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        {% endif %}

        <h3 style="font-size: 22px; font-weight: 800; margin-bottom: 8px;">{{ component.title|default('احصل على خصم حصري!') }}</h3>
        <p style="font-size: 14px; color: #6b7280; margin-bottom: 20px;">{{ component.description|default('اشترك في نشرتنا البريدية واحصل على خصم فوري') }}</p>

        {% if component.discount_code %}
        <div style="background: var(--card-bg); border: 2px dashed var(--primary); border-radius: var(--radius-md); padding: 12px; margin-bottom: 20px;">
            <span style="font-size: 12px; color: #6b7280;">كود الخصم:</span>
            <strong style="font-size: 20px; color: var(--primary); display: block;">{{ component.discount_code }}</strong>
        </div>
        {% endif %}

        <salla-newsletter></salla-newsletter>
    </div>
</div>

<script>
(function() {
    if (localStorage.getItem('newsletter_closed')) return;
    setTimeout(function() {
        var popup = document.getElementById('newsletterPopup');
        if (popup) popup.classList.add('quick-view-overlay--active');
    }, 5000);
})();
</script>
