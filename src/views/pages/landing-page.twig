{# ============================================
   Landing Page - ثيم تحويل
   صفحة هبوط مخصصة لمنتج واحد - مصممة لأقصى تحويل
   ============================================ #}

{% extends "layouts/master.twig" %}

{% block content %}

{# Hero Section #}
<section style="position: relative; min-height: 500px; display: flex; align-items: center; background: linear-gradient(135deg, var(--primary), #7c3aed); color: #fff; text-align: center; padding: 60px 0;">
    <div class="container">
        <h1 style="font-size: 36px; font-weight: 900; margin-bottom: 16px; line-height: 1.3;">{{ page.title }}</h1>
        <p style="font-size: 18px; opacity: 0.9; max-width: 600px; margin: 0 auto 32px; line-height: 1.7;">{{ page.description }}</p>
        <a href="#product-section" style="display: inline-flex; align-items: center; gap: 8px; padding: 16px 40px; background: var(--cta); color: #fff; font-size: 18px; font-weight: 800; border-radius: var(--radius-md); box-shadow: var(--shadow-xl);">
            {{ trans('common.buy_now') }}
            <i class="sicon-keyboard_arrow_down"></i>
        </a>
    </div>
</section>

{# Trust Indicators #}
<div style="background: var(--card-bg); padding: 20px 0; border-bottom: 1px solid var(--border);">
    <div class="container">
        <div style="display: flex; justify-content: center; gap: 32px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="sicon-shield-check" style="color: var(--cta); font-size: 20px;"></i>
                <span style="font-size: 14px; font-weight: 600;">{{ trans('trust.secure_payment') }}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="sicon-truck" style="color: var(--cta); font-size: 20px;"></i>
                <span style="font-size: 14px; font-weight: 600;">{{ trans('trust.fast_delivery') }}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="sicon-refresh" style="color: var(--cta); font-size: 20px;"></i>
                <span style="font-size: 14px; font-weight: 600;">{{ trans('trust.easy_return') }}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <i class="sicon-check-circle" style="color: var(--cta); font-size: 20px;"></i>
                <span style="font-size: 14px; font-weight: 600;">{{ trans('trust.original') }}</span>
            </div>
        </div>
    </div>
</div>

{# Product Section #}
<section id="product-section" class="section">
    <div class="container">
        {{ page.content|raw }}
    </div>
</section>

{# FAQ #}
<section class="section" style="background: var(--card-bg);">
    <div class="container">
        <div class="section__header">
            <h2 class="section__title">{{ trans('faq.title') }}</h2>
        </div>
        <div class="faq-list">
            {# FAQ items will be rendered from page content #}
        </div>
    </div>
</section>

{% endblock %}
