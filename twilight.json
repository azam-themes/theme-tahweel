  "features": [
    "component-featured-products",
    "component-fixed-banner",
    "component-fixed-products",
    "component-photos-slider",
    "component-products-slider",
    "component-parallax-background",
    "component-random-testimonials",
    "component-testimonials",
    "component-square-photos",
    "component-store-features",
    "component-youtube",
    "filters"
  ],
  "components": [
    {
      "name": "hero-banner",
      "title": "بانر رئيسي متحرك",
      "icon": "sicon-image-carousel",
      "path": "home.hero-banner",
      "fields": [
        {
          "id": "slides",
          "type": "collection",
          "format": "collection",
          "required": true,
          "minLength": 1,
          "maxLength": 5,
          "fields": [
            {"id": "image", "type": "string", "format": "image", "label": "صورة البانر"},
            {"id": "title", "type": "string", "label": "العنوان الرئيسي"},
            {"id": "subtitle", "type": "string", "format": "textarea", "label": "النص التوضيحي"},
            {"id": "btn_text", "type": "string", "label": "نص الزر"},
            {"id": "btn_url", "type": "string", "label": "رابط الزر"}
          ]
        }
      ]
    },
    {
      "name": "trust-badges",
      "title": "شارات الثقة والضمان",
      "icon": "sicon-shield-check",
      "path": "home.trust-badges",
      "fields": [
        {
          "id": "badges",
          "type": "collection",
          "format": "collection",
          "required": true,
          "minLength": 1,
          "maxLength": 6,
          "fields": [
            {"id": "icon", "type": "string", "label": "أيقونة (sicon class)"},
            {"id": "title", "type": "string", "label": "العنوان"},
            {"id": "description", "type": "string", "label": "الوصف"}
          ]
        }
      ]
    },
    {
      "name": "countdown-offer",
      "title": "عرض مع عداد تنازلي",
      "icon": "sicon-clock",
      "path": "home.countdown-offer",
      "fields": [
        {"id": "bg_image", "type": "string", "format": "image", "label": "صورة الخلفية"},
        {"id": "title", "type": "string", "label": "عنوان العرض"},
        {"id": "description", "type": "string", "format": "textarea", "label": "وصف العرض"},
        {"id": "end_date", "type": "string", "label": "تاريخ انتهاء العرض (YYYY-MM-DD HH:MM)"},
        {"id": "btn_text", "type": "string", "label": "نص الزر"},
        {"id": "btn_url", "type": "string", "label": "رابط الزر"}
      ]
    },
    {
      "name": "social-proof",
      "title": "إثبات اجتماعي - آراء العملاء",
      "icon": "sicon-star",
      "path": "home.social-proof",
      "fields": [
        {"id": "title", "type": "string", "label": "عنوان القسم"},
        {
          "id": "reviews",
          "type": "collection",
          "format": "collection",
          "required": true,
          "minLength": 1,
          "maxLength": 12,
          "fields": [
            {"id": "name", "type": "string", "label": "اسم العميل"},
            {"id": "rating", "type": "string", "label": "التقييم (1-5)"},
            {"id": "text", "type": "string", "format": "textarea", "label": "نص التقييم"},
            {"id": "avatar", "type": "string", "format": "image", "label": "صورة العميل (اختياري)"}
          ]
        }
      ]
    },
    {
      "name": "categories-grid",
      "title": "شبكة الأقسام المميزة",
      "icon": "sicon-grid",
      "path": "home.categories-grid",
      "fields": [
        {"id": "title", "type": "string", "label": "عنوان القسم"},
        {"id": "columns", "type": "string", "label": "عدد الأعمدة (2-4)"}
      ]
    },
    {
      "name": "benefits-bar",
      "title": "شريط المميزات والفوائد",
      "icon": "sicon-check-circle",
      "path": "home.benefits-bar",
      "fields": [
        {
          "id": "benefits",
          "type": "collection",
          "format": "collection",
          "required": true,
          "minLength": 1,
          "maxLength": 4,
          "fields": [
            {"id": "icon", "type": "string", "label": "أيقونة"},
            {"id": "title", "type": "string", "label": "العنوان"},
            {"id": "description", "type": "string", "label": "الوصف"}
          ]
        }
      ]
    },
    {
      "name": "faq-section",
      "title": "الأسئلة الشائعة",
      "icon": "sicon-help-circle",
      "path": "home.faq-section",
      "fields": [
        {"id": "title", "type": "string", "label": "عنوان القسم"},
        {
          "id": "questions",
          "type": "collection",
          "format": "collection",
          "required": true,
          "minLength": 1,
          "maxLength": 10,
          "fields": [
            {"id": "question", "type": "string", "label": "السؤال"},
            {"id": "answer", "type": "string", "format": "textarea", "label": "الإجابة"}
          ]
        }
      ]
    },
    {
      "name": "newsletter-popup",
      "title": "نافذة الاشتراك بالنشرة البريدية",
      "icon": "sicon-mail",
      "path": "home.newsletter-popup",
      "fields": [
        {"id": "title", "type": "string", "label": "العنوان"},
        {"id": "description", "type": "string", "format": "textarea", "label": "الوصف"},
        {"id": "discount_code", "type": "string", "label": "كود الخصم (اختياري)"},
        {"id": "bg_image", "type": "string", "format": "image", "label": "صورة الخلفية"}
      ]
    }
  ]
}
