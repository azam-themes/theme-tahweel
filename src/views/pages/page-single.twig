{% extends "layouts/master.twig" %}

{% block content %}

<div style="background: var(--card-bg); padding: 12px 0; border-bottom: 1px solid var(--border);">
    <div class="container">
        <salla-breadcrumb></salla-breadcrumb>
    </div>
</div>

<section class="section">
    <div class="container">
        <div style="max-width: 800px; margin: 0 auto;">
            <h1 style="font-size: 28px; font-weight: 800; margin-bottom: 24px;">{{ page.title }}</h1>
            <div style="font-size: 15px; line-height: 2; color: #4b5563;">
                {{ page.content|raw }}
            </div>
        </div>
    </div>
</section>

{% endblock %}
