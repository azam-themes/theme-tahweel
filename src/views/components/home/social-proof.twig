{# ============================================
   Social Proof Component - ثيم تحويل
   آراء العملاء والإثبات الاجتماعي لزيادة الثقة
   ============================================ #}

<section class="section social-proof">
    <div class="container">
        <div class="section__header">
            <h2 class="section__title">{{ component.title|default(trans('product.reviews')) }}</h2>
            <p class="section__subtitle">ماذا يقول عملاؤنا عنا</p>
        </div>

        <div class="reviews-grid">
            {% for review in component.reviews %}
            <div class="review-card">
                <div class="review-card__header">
                    <div class="review-card__avatar">
                        {% if review.avatar %}
                        <img src="{{ review.avatar }}" alt="{{ review.name }}" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                        {% else %}
                        {{ review.name|first }}
                        {% endif %}
                    </div>
                    <div>
                        <div class="review-card__name">{{ review.name }}</div>
                        <div class="review-card__stars">
                            {% for i in 1..5 %}
                            <i class="sicon-star{{ i <= review.rating ? '' : '-empty' }}"></i>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <p class="review-card__text">{{ review.text }}</p>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
