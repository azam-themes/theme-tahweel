{# ============================================
   Blog Listing Page - ثيم تحويل
   ============================================ #}

{% extends "layouts/master.twig" %}

{% block content %}

<section class="section">
    <div class="container">
        <div class="section__header">
            <h1 class="section__title">{{ trans('common.blog') }}</h1>
        </div>

        <div style="display: grid; grid-template-columns: repeat(1, 1fr); gap: 24px;">
            {% for post in posts %}
            <article style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: var(--transition);">
                <a href="{{ post.url }}" style="display: grid; grid-template-columns: 1fr;">
                    {% if post.image %}
                    <div style="aspect-ratio: 16/9; overflow: hidden;">
                        <img src="{{ post.image.url }}" alt="{{ post.title }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    {% endif %}
                    <div style="padding: 20px;">
                        <time style="font-size: 12px; color: #9ca3af;">{{ post.date }}</time>
                        <h2 style="font-size: 18px; font-weight: 700; margin: 8px 0; line-height: 1.5;">{{ post.title }}</h2>
                        <p style="font-size: 14px; color: #6b7280; line-height: 1.7;">{{ post.excerpt }}</p>
                        <span style="color: var(--primary); font-weight: 600; font-size: 14px; margin-top: 12px; display: inline-block;">
                            {{ trans('common.view_details') }} <i class="sicon-keyboard_arrow_left"></i>
                        </span>
                    </div>
                </a>
            </article>
            {% endfor %}
        </div>
    </div>
</section>

{% endblock %}
